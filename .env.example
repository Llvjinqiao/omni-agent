# EdgeOne Makers 平台注入（线上自动有，本地调试请自己填）
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# 联网搜索（腾讯云元宝搜索 / Web Search API，可不填；不填会退回 360 搜索兜底）
WSA_API_KEY=

# AI 画图（阿里云百炼 DashScope，不填则画图工具不可用）
DASHSCOPE_API_KEY=
IMAGE_MODEL=wanx2.1-t2i-turbo
